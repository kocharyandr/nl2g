OPENAI_API_BASE=
OPENAI_API_KEY=""
OPENAI_MODEL_NAME=""

# EDIT_SERVICE_URL=http://192.168.235.188:8888/edit
EDIT_SERVICE_URL=http://127.0.0.1:8001/edit
EDIT_USE_STUB=false
DIFFUSION_HOST=127.0.0.1
DIFFUSION_PORT=8001
DIFFUSION_MODEL_NAME=flux
DIFFUSION_TIMEOUT_SEC=300

IMAGE_AUTO_VALIDATION_ENABLED=true
IMAGE_AUTO_VALIDATION_ITERS=3

CHART_RENDER_MAX_RETRIES=3
LLM_JSON_OUTPUT_ENABLED=true
LLM_DISABLE_REASONING=true

STATE_STORE_REDIS_ENABLED=true
STATE_STORE_REDIS_URL=redis://redis:6379/0
STATE_STORE_REDIS_PREFIX=chart_agent:state
STATE_STORE_REDIS_TTL_SEC=0
SUMMARY_HISTORY_MAX_LEN=20
SUMMARY_TRIGGER_MIN_MESSAGES=15
LOG_LEVEL=DEBUG

LANGFUSE_ENABLED=true
LANGFUSE_PROMPTS_ENABLED=false
LANGFUSE_HOST=http://host.docker.internal:3000
LANGFUSE_PUBLIC_KEY=pk-lf-f80105b3-b1f3-4d37-a298-459d3ace81a6
LANGFUSE_SECRET_KEY=sk-lf-64878a55-31ad-4cfa-ab46-2e01d0b07ea8
LANGFUSE_PROMPT_LABEL=production

GUARDRAILS_ENABLED=true
GUARDRAILS_SAFETY_ENABLED=true
GUARDRAILS_INTENT_ROUTING_ENABLED=true
GUARDRAILS_HOST=host.docker.internal
GUARDRAILS_PORT=8600
GUARDRAILS_API_VERSION=/api/v1
GUARDRAILS_TIMEOUT_SEC=10
GUARDRAILS_CONFIDENCE_THRESHOLD=0.7
GUARDRAILS_FAIL_OPEN=true

# ── SQL agent (NL2SQL data source) ──
# Off by default: with the flag off the system behaves exactly as before.
SQL_AGENT_ENABLED=false
SQL_AGENT_URL=http://host.docker.internal:8500
SQL_AGENT_TIMEOUT_SEC=120
SQL_AGENT_MAX_ROWS=5000
# Branch chosen by the explicit UI toggle, not by intent classification.
SQL_AGENT_INTENT_ROUTING_ENABLED=false
# Какую базу спрашивать. Пусто — берётся база по умолчанию из sql_agent.
# Список: curl -s localhost:8500/datasources
SQL_AGENT_DATASOURCE_ID=
