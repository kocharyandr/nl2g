# DOCKER CONTAINER
IMAGE_TAG=guardrails-api:latest
PROFILE=cpu
API_CONTAINER_NAME=prod_guardrails_api

# API
API_PORT=8600
API_VERSION="/api/v1"
API_DESCRIPTION="Guardrails API"
API_TITLE="Guardrails API"
PROJECT_VERSION="0.1.0"

# Model
# Recommended models:
#   - fastino/gliner2-multi-v1   — multilingual base (205M), good Russian support, fast on CPU
#   - fastino/gliner2-large-v1   — large (340M), more accurate, slower
# (legacy default in config.py: hivetrace/gliner-guard-omni — GLiNER v1)
MODEL_NAME=fastino/gliner2-multi-v1
# DEVICE auto-resolves to cuda if available, otherwise cpu. Override if needed.
# DEVICE=cpu

# Thresholds — calibrated for fastino/gliner2-multi-v1 zero-shot.
# This model is more "trigger-happy" on safety labels than guard-omni;
# defaults from config.py (0.2/0.5) cause false-positives on neutral RU text.
# Tighter thresholds → reject only clearly unsafe content.
THRESHOLD_SAFETY=0.999   # дипломное: 0.85; ложные срабатывания на метафорах
# Note: gliner2-multi-v1 ловит "замени цвет" как instruction_override conf~0.99,
# поэтому ADVERSARIAL держим почти максимальным — только очевидные инъекции
THRESHOLD_ADVERSARIAL=0.999
# HARMFUL: у gliner2-multi-v1 на русском нет разделяющего порога — замер:
#   «как сделать бомбу…инструкция» → dangerous_instructions 0.743
#   «сделай графики газированными словно кока кола» → 0.803 (!)
# Любой порог, ловящий первое, режет второе. 0.9 = ловим только вопиющее.
THRESHOLD_HARMFUL=0.9    # дипломное: 0.7
# INTENT=adversarial тоже триггерится на нормальных императивах
THRESHOLD_INTENT=0.999
THRESHOLD_TONE=0.999     # дипломное: 0.85; «кока-кола» давала aggressive 0.857
# POLICY: weather/date_time/politics — у нас нет таких ограничений
THRESHOLD_POLICY=0.999   # дипломное: 0.99

# Optional: bind-mount host HF cache (compose default: ${HOME}/.cache/huggingface)
# HF_CACHE_DIR=/Users/maantonov/.cache/huggingface
