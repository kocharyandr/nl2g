# DOCKER CONTAINER
API_CONTAINER_NAME=
# PROFILE: gpu | cpu. Selects docker-compose profile + torch build variant.
# Default gpu if unset. Override per host (no nvidia drivers → PROFILE=cpu).
PROFILE=gpu
# API
API_PORT=
API_VERSION=
API_DESCRIPTION=
API_TITLE=
PROJECT_VERSION=
# MODEL
# Recommended:
#   fastino/gliner2-multi-v1   — multilingual base (205M), default
#   fastino/gliner2-large-v1   — large (340M), more accurate
MODEL_NAME=fastino/gliner2-multi-v1
# DEVICE auto-resolves (cuda if available else cpu). Override only if needed.
# DEVICE=cpu
# Optional: bind-mount host HF cache (defaults to ${HOME}/.cache/huggingface)
# HF_CACHE_DIR=
# THRESHOLDS
THRESHOLD_SAFETY=
THRESHOLD_ADVERSARIAL=
THRESHOLD_HARMFUL=
THRESHOLD_INTENT=
THRESHOLD_TONE=
THRESHOLD_POLICY=
# REJECT MESSAGES (optional, RU defaults in config)
MSG_REJECT_SAFETY=
MSG_REJECT_ADVERSARIAL=
MSG_REJECT_HARMFUL=
MSG_REJECT_INTENT=
MSG_REJECT_TONE=
MSG_REJECT_POLICY=