LOG_LEVEL=INFO

# ── Database (Variant A: raw result set, no aggregation here) ──
DB_BACKEND=sqlite
# База по умолчанию.
DB_PATH=/data/GeoNuclearData.sqlite
DB_ID=GeoNuclearData
# Каталоги, сканируемые на *.sqlite (через ":"). Каждый найденный файл
# становится источником, id = имя файла без расширения. Позволяет одному
# сервису отвечать по любой базе из набора без перезапуска.
DATASOURCE_ROOTS=/data
DB_MAX_ROWS=5000
DB_STATEMENT_TIMEOUT_SEC=15

# Table/column descriptions. +4.9 p.p. execution accuracy in the NL2SQL work.
PROFILES_DIR=/profiles

# ── LLM roles ──
# One OpenAI-compatible endpoint per role, each pinned to its own LoRA adapter.
# Local MLX: scripts/run_mlx_servers.sh (host.docker.internal from a container).
# vLLM with --enable-lora works unchanged — only these URLs move.
LLM_API_KEY=local-key
LLM_TIMEOUT_SEC=120
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512

# Вариант 1 — Ollama (рекомендуется): scripts/setup_ollama_lora.sh
# Один порт, роли отличаются только именем модели.
SCHEMA_API_BASE=http://host.docker.internal:11434/v1
SCHEMA_MODEL_NAME=nl2sql-schema
SQL_API_BASE=http://host.docker.internal:11434/v1
SQL_MODEL_NAME=nl2sql-sql
CRITIC_API_BASE=http://host.docker.internal:11434/v1
CRITIC_MODEL_NAME=nl2sql-critic

# Вариант 2 — MLX: scripts/run_mlx_servers.sh (три порта, три процесса)
# SCHEMA_API_BASE=http://host.docker.internal:8071/v1
# SCHEMA_MODEL_NAME=default_model
# SQL_API_BASE=http://host.docker.internal:8072/v1
# SQL_MODEL_NAME=default_model
# CRITIC_API_BASE=http://host.docker.internal:8073/v1
# CRITIC_MODEL_NAME=default_model

# ── Pipeline ──
CRITIC_MAX_ATTEMPTS=3
USE_PROFILE=true
# Minimal first version answers ok/error only; turn on for the third stage.
CLARIFICATION_ENABLED=false
EXPLANATION_LLM_CALL=true
